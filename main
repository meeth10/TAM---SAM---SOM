<script>
/* ── STATE ── */
const S = {
  approach:'topdown', buMethod:'customers',
  marketName:'', yearLabel:'2025E',
  tdTAM:'', tdSAMPct:30, tdSOMPct:10,
  buCust:'', buACV:'', buCustSAMx:5, buCustTAMx:5,
  buTx:'', buTicket:'', buFreq:12, buTxSAMx:5, buTxTAMx:5,
  bullTAM:20, bullSAM:15, bullSOM:30,
  bearTAM:-20, bearSAM:-15, bearSOM:-30,
};
let tab = 'm';

/* ── PALETTE (canvas only) ── */
const CLR = {
  bg:'#FFFFFF', bg2:'#F8FAFC',
  navy:'#0C2340', navyMid:'#163556',
  tam:'#1A4F8A', tamFill:'rgba(26,79,138,0.9)',
  sam:'#2272BE', samFill:'rgba(34,114,190,0.92)',
  som:'#9C5215', somFill:'rgba(156,82,21,0.93)',
  border:'#D4DCE8', muted:'#8896AA', text:'#0F1C2E',
  green:'#047857', red:'#B91C1C',
};

/* ── HELPERS ── */
const fmt = b => {
  if (!b || isNaN(b) || b <= 0) return '—';
  if (b >= 1000) return '$' + (b/1000).toFixed(2) + 'T';
  if (b >= 1)    return '$' + b.toFixed(2) + 'B';
  if (b >= 0.001)return '$' + (b*1000).toFixed(1) + 'M';
  return '$' + Math.round(b*1e9);
};
const pct = (a, b) => (!b || b <= 0) ? '—' : ((a/b)*100).toFixed(1) + '%';

function compute(ta=0, sa=0, so=0) {
  let tam=0, sam=0, som=0;
  if (S.approach === 'topdown') {
    tam = parseFloat(S.tdTAM) || 0;
    sam = tam * S.tdSAMPct / 100;
    som = sam * S.tdSOMPct / 100;
  } else if (S.buMethod === 'customers') {
    som = ((parseFloat(S.buCust)||0) * (parseFloat(S.buACV)||0)) / 1e9;
    sam = som * S.buCustSAMx;
    tam = sam * S.buCustTAMx;
  } else {
    som = ((parseFloat(S.buTx)||0) * (parseFloat(S.buTicket)||0) * (parseFloat(S.buFreq)||0)) / 1e9;
    sam = som * S.buTxSAMx;
    tam = sam * S.buTxTAMx;
  }
  return { tam: tam*(1+ta/100), sam: sam*(1+sa/100), som: som*(1+so/100) };
}

/* ── FUNNEL DRAW ── */
function drawFunnel(canvas, tam, sam, som, meta=false) {
  if (!canvas) return;
  const ctx  = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  ctx.clearRect(0, 0, W, H);

  /* Background */
  ctx.fillStyle = CLR.bg; ctx.fillRect(0, 0, W, H);

  /* Header strip (meta/export only) */
  const topPad = meta ? 92 : 16;
  if (meta) {
    ctx.fillStyle = CLR.navy; ctx.fillRect(0, 0, W, 5);
    const title = (S.marketName || 'Market Sizing Analysis').toUpperCase();
    ctx.fillStyle = CLR.navy;
    ctx.font = 'bold 22px "DM Serif Display", Georgia, serif';
    ctx.textAlign = 'left'; ctx.fillText(title, 56, 42);
    ctx.fillStyle = CLR.muted;
    ctx.font = '11px "DM Sans", Arial, sans-serif';
    ctx.fillText('TAM  ·  SAM  ·  SOM  |  ' + (S.approach === 'topdown' ? 'Top-down' : 'Bottom-up') + ' approach', 56, 62);
    ctx.textAlign = 'right';
    ctx.fillText(S.yearLabel, W - 56, 42);
    ctx.strokeStyle = CLR.border; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(56, 76); ctx.lineTo(W-56, 76); ctx.stroke();
  }

  /* ── Funnel geometry ── */
  const has  = tam > 0;
  const topY = topPad + (meta ? 8 : 0);
  const annW = meta ? W * 0.40 : W * 0.42; /* right label column */
  const funnelCX  = annW / 2;
  const maxHW = funnelCX * 0.92;          /* half-width at TAM */

  const wTAM = maxHW;
  const wSAM = has && sam > 0 ? Math.max(maxHW * (sam/tam), maxHW * 0.12) : maxHW * 0.58;
  const wSOM = has && som > 0 ? Math.max(maxHW * (som/tam), maxHW * 0.045) : maxHW * 0.20;

  const botY = H - (meta ? 96 : 14);
  const fH   = botY - topY;
  const gap  = Math.round(fH * 0.016);
  const secH = Math.round((fH - gap * 2) / 3);

  const sections = [
    { key:'TAM', sub:'Total Addressable Market',      val:tam, fill:CLR.tamFill, accent:CLR.tam, wTop:wTAM, wBot:wSAM, pctStr:'100% of market' },
    { key:'SAM', sub:'Serviceable Addressable Market', val:sam, fill:CLR.samFill, accent:CLR.sam, wTop:wSAM, wBot:wSOM, pctStr:pct(sam,tam)+' of TAM' },
    { key:'SOM', sub:'Serviceable Obtainable Market',  val:som, fill:CLR.somFill, accent:CLR.som, wTop:wSOM, wBot:wSOM*0.65, pctStr:pct(som,sam)+' of SAM' },
  ];

  const labelFS  = meta ? 14 : 12;
  const valFS    = meta ? 16 : 13;
  const subFS    = meta ? 12 : 11;
  const annX     = annW + (meta ? 36 : 24);

  sections.forEach((sec, i) => {
    const y0   = topY + i * (secH + gap);
    const y1   = y0 + secH;
    const midY = (y0 + y1) / 2;
    const x0L  = funnelCX - sec.wTop;
    const x0R  = funnelCX + sec.wTop;
    const x1L  = funnelCX - sec.wBot;
    const x1R  = funnelCX + sec.wBot;

    /* Trapezoid */
    ctx.beginPath();
    ctx.moveTo(x0L, y0); ctx.lineTo(x0R, y0);
    ctx.lineTo(x1R, y1); ctx.lineTo(x1L, y1);
    ctx.closePath();
    ctx.fillStyle = sec.fill; ctx.fill();

    /* Thin top edge line */
    if (i > 0) {
      ctx.strokeStyle = 'rgba(255,255,255,0.25)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x0L, y0); ctx.lineTo(x0R, y0); ctx.stroke();
    }

    /* Label inside */
    ctx.fillStyle = 'rgba(255,255,255,0.95)';
    ctx.font = `600 ${labelFS}px "DM Sans", Arial, sans-serif`;
    ctx.textAlign = 'center';
    ctx.fillText(sec.key, funnelCX, midY - (meta ? 8 : 6));
    ctx.fillStyle = 'rgba(255,255,255,0.72)';
    ctx.font = `${subFS}px "DM Mono", monospace`;
    ctx.fillText(fmt(sec.val), funnelCX, midY + (meta ? 12 : 9));

    /* Connector dot */
    const dotX = x1R + 4;
    ctx.strokeStyle = CLR.border; ctx.lineWidth = 0.75; ctx.setLineDash([3,3]);
    ctx.beginPath(); ctx.moveTo(dotX, midY); ctx.lineTo(annX - 8, midY); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = sec.accent;
    ctx.beginPath(); ctx.arc(annX - 8, midY, 3.5, 0, Math.PI*2); ctx.fill();

    /* Right annotation */
    ctx.fillStyle = CLR.text;
    ctx.font = `500 ${subFS}px "DM Sans", Arial, sans-serif`;
    ctx.textAlign = 'left';
    ctx.fillText(sec.sub, annX, midY - (meta ? 12 : 10));
    ctx.fillStyle = sec.accent;
    ctx.font = `700 ${valFS}px "DM Mono", monospace`;
    ctx.fillText(fmt(sec.val), annX, midY + (meta ? 7 : 6));
    ctx.fillStyle = CLR.muted;
    ctx.font = `${meta?11:10}px "DM Sans", Arial, sans-serif`;
    ctx.fillText(sec.pctStr, annX, midY + (meta ? 24 : 20));
  });

  /* ── Summary strip (export only) ── */
  if (meta) {
    const sy = botY + 14;
    ctx.fillStyle = CLR.bg2; ctx.fillRect(56, sy, W-112, 56);
    ctx.strokeStyle = CLR.border; ctx.lineWidth = 0.5; ctx.strokeRect(56, sy, W-112, 56);
    ctx.fillStyle = CLR.navy; ctx.fillRect(56, sy, 4, 56);

    const cols = [
      { l:'TAM', v:fmt(tam), c:CLR.tam },
      { l:'SAM', v:fmt(sam), c:CLR.sam },
      { l:'SOM', v:fmt(som), c:CLR.som },
      { l:'SAM / TAM', v:pct(sam,tam), c:CLR.muted },
      { l:'SOM / SAM', v:pct(som,sam), c:CLR.muted },
    ];
    const cw = (W-116) / cols.length;
    cols.forEach((c, i) => {
      const x = 60 + i*cw + cw/2;
      ctx.fillStyle = c.c; ctx.font = '700 16px "DM Mono",monospace'; ctx.textAlign = 'center';
      ctx.fillText(c.v, x, sy+26);
      ctx.fillStyle = CLR.muted; ctx.font = '9px "DM Sans",sans-serif';
      ctx.fillText(c.l, x, sy+44);
      if (i < cols.length-1) {
        ctx.strokeStyle = CLR.border; ctx.lineWidth = 0.5;
        ctx.beginPath(); ctx.moveTo(60+cw*(i+1), sy+10); ctx.lineTo(60+cw*(i+1), sy+46); ctx.stroke();
      }
    });

    /* Footer */
    const fy = sy+70;
    ctx.strokeStyle = CLR.navy; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(56,fy); ctx.lineTo(W-56,fy); ctx.stroke();
    ctx.fillStyle = CLR.muted; ctx.font = '9px "DM Sans",sans-serif';
    ctx.textAlign = 'left';  ctx.fillText('Confidential  ·  For internal use only', 56, fy+14);
    ctx.textAlign = 'right'; ctx.fillText('Market sizing model  ·  ' + S.yearLabel, W-56, fy+14);
  }
}

/* ── EXPORT ── */
function exportPNG() {
  const c = document.createElement('canvas');
  c.width = 1200; c.height = 740;
  const base = compute();
  drawFunnel(c, base.tam, base.sam, base.som, true);
  const a = document.createElement('a');
  a.download = 'market-sizing' + (S.marketName ? '-'+S.marketName.toLowerCase().replace(/\s+/g,'-') : '') + '.png';
  a.href = c.toDataURL('image/png'); a.click();
}

/* ── EVENT HANDLERS ── */
function onSlider(key, val) {
  S[key] = val;
  const sp = document.getElementById('sv-'+key);
  if (sp) {
    const u = sp.dataset.unit || '%';
    sp.textContent = (val > 0 && u === '%' ? '+' : '') + val + u;
  }
  if (tab === 'm') updateViz(); else updateSCData();
}
function onInput(key, val) { S[key] = val; if (tab === 'm') updateViz(); }

function updateViz() {
  const base = compute();
  const canvas = document.getElementById('viz');
  if (canvas) drawFunnel(canvas, base.tam, base.sam, base.som, false);
  const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  set('mv-tam', fmt(base.tam)); set('mv-sam', fmt(base.sam)); set('mv-som', fmt(base.som));
  set('ms-sam', pct(base.sam, base.tam) + ' of TAM');
  set('ms-som', pct(base.som, base.sam) + ' of SAM · ' + pct(base.som, base.tam) + ' of TAM');
}

/* ── TEMPLATES ── */
function iH(id, label, key, type, val, pre, suf) {
  return `<div class="field"><label for="${id}">${label}</label>
    <div class="finput">
      ${pre ? `<span class="fpre">${pre}</span>` : ''}
      <input id="${id}" type="${type||'number'}" value="${val||''}" placeholder="0"
        oninput="onInput('${key}',this.value)">
      ${suf ? `<span class="fsuf">${suf}</span>` : ''}
    </div></div>`;
}

function slH(label, key, min, max, step, unit, color) {
  const v = S[key], u = unit || '%';
  return `<div class="sr">
    <div class="sr-hdr">
      <span class="sr-lbl">${label}</span>
      <span class="sr-val" id="sv-${key}" data-unit="${u}"
        style="color:${color||'var(--navy)'}">${v>0&&u==='%'?'+':''}${v}${u}</span>
    </div>
    <input type="range" min="${min}" max="${max}" step="${step||1}" value="${v}"
      style="-webkit-slider-thumb:accent-color:${color||'var(--navy)'};accent-color:${color||'var(--navy)'}"
      oninput="onSlider('${key}',+this.value)">
  </div>`;
}

/* ── RENDER SIDEBAR ── */
function renderSB() {
  let h = `
    <span class="sec">Market info</span>
    ${iH('f-mn','Company / market name','marketName','text',S.marketName,'','')}
    ${iH('f-yl','Year label','yearLabel','text',S.yearLabel,'','')}
    <div class="divider"></div>
    <span class="sec">Approach</span>
    <div class="tgl">
      <button class="tgb${S.approach==='topdown'?' on':''}" onclick="S.approach='topdown';renderSB();updateViz()">Top-down</button>
      <button class="tgb${S.approach==='bottomup'?' on':''}" onclick="S.approach='bottomup';renderSB();updateViz()">Bottom-up</button>
    </div>`;

  if (S.approach === 'topdown') {
    h += `<span class="sec sec-mt">Inputs</span>
      ${iH('f-td','TAM — from report or database','tdTAM','number',S.tdTAM,'$','Bn')}
      ${slH('SAM as % of TAM','tdSAMPct',1,100,1,'%','var(--sam)')}
      ${slH('SOM as % of SAM','tdSOMPct',1,100,1,'%','var(--som)')}`;
  } else {
    h += `<span class="sec sec-mt">Method</span>
      <div class="tgl">
        <button class="tgb${S.buMethod==='customers'?' on':''}" onclick="S.buMethod='customers';renderSB();updateViz()">Customers × ACV</button>
        <button class="tgb${S.buMethod==='transactions'?' on':''}" onclick="S.buMethod='transactions';renderSB();updateViz()">Tx × Ticket × Freq</button>
      </div>
      <span class="sec sec-mt">Inputs</span>`;
    if (S.buMethod === 'customers') {
      h += iH('f-bc','Target addressable customers','buCust','number',S.buCust,'','')
        + iH('f-ba','ACV / ARPU per customer','buACV','number',S.buACV,'$','/yr')
        + slH('SAM = SOM ×','buCustSAMx',1,50,1,'×','var(--sam)')
        + slH('TAM = SAM ×','buCustTAMx',1,50,1,'×','var(--tam)');
    } else {
      h += iH('f-bt','Target transaction volume','buTx','number',S.buTx,'','')
        + iH('f-bk','Average ticket size','buTicket','number',S.buTicket,'$','')
        + slH('Frequency per year','buFreq',1,365,1,'×','var(--gray-600)')
        + slH('SAM = SOM ×','buTxSAMx',1,50,1,'×','var(--sam)')
        + slH('TAM = SAM ×','buTxTAMx',1,50,1,'×','var(--tam)');
    }
  }
  document.getElementById('sb').innerHTML = h;
}

/* ── RENDER MAIN ── */
