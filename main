/* ── RENDER SCENARIOS ── */
function renderSC() {
  document.getElementById('sc').innerHTML = `
    <div style="max-width:900px">
    <div class="sc-grid">
      <div class="card">
        <div class="sc-head" style="color:var(--green)">↑ Bull case adjustments</div>
        ${slH('TAM adjustment','bullTAM',0,100,1,'%','var(--green)')}
        ${slH('SAM adjustment','bullSAM',0,100,1,'%','var(--green)')}
        ${slH('SOM adjustment','bullSOM',0,100,1,'%','var(--green)')}
      </div>
      <div class="card">
        <div class="sc-head" style="color:var(--red)">↓ Bear case adjustments</div>
        ${slH('TAM adjustment','bearTAM',-80,0,1,'%','var(--red)')}
        ${slH('SAM adjustment','bearSAM',-80,0,1,'%','var(--red)')}
        ${slH('SOM adjustment','bearSOM',-80,0,1,'%','var(--red)')}
      </div>
    </div>
    <div id="sc-d"></div></div>`;
  updateSCData();
}

function updateSCData() {
  const base = compute();
  const bull = compute(S.bullTAM, S.bullSAM, S.bullSOM);
  const bear = compute(S.bearTAM, S.bearSAM, S.bearSOM);
  const td = document.getElementById('sc-d'); if (!td) return;
  const rows = [
    { l:'TAM', b:bear.tam, bs:base.tam, bu:bull.tam },
    { l:'SAM', b:bear.sam, bs:base.sam, bu:bull.sam },
    { l:'SOM', b:bear.som, bs:base.som, bu:bull.som },
    { l:'SAM / TAM', b:pct(bear.sam,bear.tam), bs:pct(base.sam,base.tam), bu:pct(bull.sam,bull.tam), p:1 },
    { l:'SOM / SAM', b:pct(bear.som,bear.sam), bs:pct(base.som,base.sam), bu:pct(bull.som,bull.sam), p:1 },
  ];
  td.innerHTML = `
    <div class="card" style="margin-bottom:12px">
      <div class="card-head">Scenario comparison</div>
      <table><thead><tr>
        <th style="text-align:left">Metric</th>
        <th style="color:var(--red)">Bear</th>
        <th>Base</th>
        <th style="color:var(--green)">Bull</th>
      </tr></thead><tbody>
        ${rows.map(r=>`<tr>
          <td>${r.l}</td>
          <td style="color:var(--red)">${r.p?r.b:fmt(r.b)}</td>
          <td style="font-weight:500">${r.p?r.bs:fmt(r.bs)}</td>
          <td style="color:var(--green)">${r.p?r.bu:fmt(r.bu)}</td>
        </tr>`).join('')}
      </tbody></table>
    </div>
    <div class="card">
      <div class="card-head" style="margin-bottom:6px">Range visualization</div>
      <div style="display:flex;gap:12px;font-size:11px;color:var(--gray-400);margin-bottom:12px">
        <span style="color:var(--red)">■ bear</span>
        <span>■ base</span>
        <span style="color:var(--green)">■ bull</span>
      </div>
      ${['tam','sam','som'].map(k=>{
        const max=Math.max(bull[k],.001);
        const bp=(Math.min(bear[k]/max,1)*100).toFixed(1);
        const bsp=(Math.min(base[k]/max,1)*100).toFixed(1);
        return `<div style="margin-bottom:12px">
          <div style="font-size:11px;font-weight:500;color:var(--gray-600);margin-bottom:4px">${k.toUpperCase()}</div>
          <div class="bk">
            <div style="position:absolute;inset:0;background:rgba(4,120,87,.07)"></div>
            <div style="position:absolute;left:0;top:0;height:100%;width:${bsp}%;background:rgba(26,79,138,.1);border-right:2px solid rgba(26,79,138,.25)"></div>
            <div style="position:absolute;left:0;top:0;height:100%;width:${bp}%;background:rgba(185,28,28,.08);border-right:2px solid rgba(185,28,28,.3)"></div>
            <div style="position:absolute;right:10px;top:0;height:100%;display:flex;align-items:center;gap:12px;font-size:11px;font-family:'DM Mono',monospace">
              <span style="color:var(--red)">${fmt(bear[k])}</span>
              <span style="font-weight:500">${fmt(base[k])}</span>
              <span style="color:var(--green)">${fmt(bull[k])}</span>
            </div>
          </div>
        </div>`;
      }).join('')}
    </div>`;
}

/* ── TAB SWITCH ── */
function swTab(t) {
  tab = t;
  document.getElementById('vm').style.display = t === 'm' ? 'flex' : 'none';
  document.getElementById('vs').style.display = t === 's' ? 'block' : 'none';
  document.getElementById('tb-m').className = 'tab-btn' + (t === 'm' ? ' on' : '');
  document.getElementById('tb-s').className = 'tab-btn' + (t === 's' ? ' on' : '');
  if (t === 'm') { renderSB(); renderMN(); } else renderSC();
}

/* ── INIT ── */
renderSB(); renderMN();
window.addEventListener('resize', () => { if (tab === 'm') updateViz(); });
</script>
</body>
</html>
